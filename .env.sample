# Copy to .env and chmod 600 (never commit a real .env)
#   cp .env.sample .env && chmod 600 .env

# --- Public / site ---
SITE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
HTTP_PORT=8080
LOG_LEVEL=INFO

# --- Admin auth (seeded on first boot) ---
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Credential encryption (AES-256-GCM) -------------------------------------
# Required before any API key can be stored. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing this key makes stored credentials unreadable; rotating it requires
# re-entering the keys.
CREDENTIALS_ENCRYPTION_KEY=

# --- Postgres / Redis ---
POSTGRES_USER=scalper
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=scalper
DATABASE_URL=postgresql+asyncpg://scalper:change-me-db-password@db:5432/scalper
REDIS_URL=redis://redis:6379/0

# --- Trading mode -------------------------------------------------------------
# backtest | paper | testnet | live
# paper and backtest never place an order. live additionally requires an explicit
# in-app confirmation; the bot always starts stopped after a restart.
TRADING_MODE=paper
LIVE_CONFIRM_PHRASE=ENABLE LIVE TRADING
STARTING_PAPER_EQUITY_USDT=10000

# --- Binance (trading only, withdrawals DISABLED, IP-restricted) --------------
# NEVER enable withdrawal permission on this key. The bot refuses to go live with
# a key that can withdraw.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional HTTP(S) proxy when the host region is Binance-blocked (HTTP 451).
BINANCE_PROXY=
EXCHANGE_MARKET=spot
FUTURES_ENABLED=false
FUTURES_LEVERAGE=3
FUTURES_MAX_LEVERAGE=5
FUTURES_MARGIN_TYPE=isolated
MIN_LIQUIDATION_DISTANCE_PCT=8

# --- Symbols and timeframes ---
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT
TIMEFRAME_PRIMARY=15m
TIMEFRAME_SETUP=5m
TIMEFRAME_ENTRY=1m
CANDLE_LIMIT=300
MARKET_DATA_STALENESS_SECONDS=180

# --- Costs (used by signals, sizing and backtests) ---
TAKER_FEE_PCT=0.04
MAKER_FEE_PCT=0.02
SLIPPAGE_PCT=0.02

# --- Risk ---------------------------------------------------------------------
RISK_PER_TRADE_PCT=0.35
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MAX_POSITIONS=2
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_HOUR=6
MAX_SYMBOL_EXPOSURE_PCT=100
MAX_TOTAL_EXPOSURE_PCT=150
LOSS_COOLDOWN_MINUTES=20

# --- Stops and targets ---
STOP_MODE=atr            # atr | structure | fixed
ATR_STOP_MULTIPLIER=1.5
FIXED_STOP_PCT=0.5
STRUCTURE_LOOKBACK=20
TP1_R_MULTIPLE=1.5
TP2_R_MULTIPLE=2.5
TP1_CLOSE_FRACTION=0.5
MOVE_STOP_TO_BREAKEVEN_AFTER_TP1=true
TRAILING_ENABLED=true
TRAILING_ATR_MULTIPLIER=2.0

# --- Strategies and scoring ---
STRATEGY_TREND_PULLBACK=true
STRATEGY_BREAKOUT=true
STRATEGY_RANGE_SCALPING=true
MINIMUM_SIGNAL_SCORE=75
WEIGHT_TREND=25
WEIGHT_MOMENTUM=20
WEIGHT_VOLUME=15
WEIGHT_VOLATILITY=15
WEIGHT_STRUCTURE=15
WEIGHT_ENTRY=10

# --- AI assistant (analysis only; server-side key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_ENABLED=true

# --- Alerts (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Runtime ---
ENGINE_INTERVAL_SECONDS=20
RECONCILE_INTERVAL_SECONDS=120
HOST=0.0.0.0
PORT=8000
