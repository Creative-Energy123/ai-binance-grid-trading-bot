# Copy to .env and chmod 600 (never commit real .env)
# cp .env.sample .env && chmod 600 .env

# --- Public / site ---
SITE_URL=https://trade.creativeenergy.pk
CORS_ORIGINS=https://trade.creativeenergy.pk,http://localhost:5173,http://localhost:8000

# --- Admin auth (seeded on first boot) ---
ADMIN_EMAIL=admin@trade.creativeenergy.pk
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-jwt-secret-at-least-32-characters

# --- Postgres (docker-compose) ---
POSTGRES_USER=gridbot
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=gridbot
DATABASE_URL=postgresql+asyncpg://gridbot:change-me-db-password@db:5432/gridbot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Binance (trading only, withdrawals DISABLED, IP-restrict to VPS) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Default true — keep true until backtests and paper runs look sane
BINANCE_TESTNET=true
# Optional HTTP(S) proxy when VPS region is Binance-blocked (HTTP 451). Also reads HTTPS_PROXY.
# Example: http://user:pass@proxy.example.com:8080
BINANCE_PROXY=
# HTTPS_PROXY=http://proxy.example.com:8080
MAX_CAPITAL_USDT=500
DEFAULT_SYMBOL=BTC/USDT

# --- Anthropic (server-side only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_ANALYSIS_INTERVAL_MINUTES=30
# Suggested grid changes stay manual unless you opt in
AI_AUTO_APPLY=false

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Runtime ---
PRICE_POLL_SECONDS=15
HOST=0.0.0.0
PORT=8000
